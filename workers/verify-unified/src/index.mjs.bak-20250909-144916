async function handleVerify(req) {
  try {
    const bodyText = await req.text();
    let json;
    try { json = JSON.parse(bodyText); }
    catch (e) { return jsonResponse({ ok: false, error: "Invalid JSON body", detail: e?.message }, 400); }

    const symbols = {
      getEntriesDeep: typeof getEntriesDeep,
      validateUnified: typeof validateUnified,
      verifyEntry: typeof verifyEntry,
      ajv: (typeof ajv === "object" && typeof ajv.errorsText === "function") ? "ok" : typeof ajv
    };
    if (symbols.getEntriesDeep !== "function" || symbols.validateUnified !== "function" ||
        symbols.verifyEntry !== "function" || symbols.ajv === "undefined") {
      return jsonResponse({ ok: false, error: "Verifier not wired", symbols }, 500);
    }

    const maybeEntries = getEntriesDeep(json);
    const root = (maybeEntries && !("entries" in json)) ? { entries: maybeEntries } : json;

    if (!validateUnified(root)) {
      return jsonResponse({ ok: false, error: "Schema validation failed",
                           issues: ajv.errorsText(validateUnified.errors, { separator: "\n" }) }, 400);
    }

    const results = [];
    let verified = 0, failed = 0, hash_mismatch = 0, signature_failed = 0;
    for (const entry of root.entries) {
      try {
        const r = await verifyEntry(entry);
        results.push(r);
        if (r.ok) verified++; else failed++;
        if (!r.hash_ok) hash_mismatch++;
        if (!r.sig_ok) signature_failed++;
      } catch (e) {
        results.push({ ok: false, error: e?.message ?? String(e) });
        failed++;
      }
    }

    return jsonResponse({
      ok: failed === 0,
      total: root.entries.length,
      verified, failed, hash_mismatch, signature_failed, results,
    }, failed ? 400 : 200);
  } catch (err) {
    return jsonResponse({ ok: false, error: err?.message ?? String(err),
                          stack: (err?.stack ?? "").split("\n").slice(0,8) }, 500);
  }
}

