async function sha256_b64(str){
  const data = new TextEncoder().encode(str);
  const digest = await crypto.subtle.digest("SHA-256", data);
  let s = ""; const bytes = new Uint8Array(digest);
  for (let i=0;i<bytes.length;i++) s += String.fromCharCode(bytes[i]);
  return btoa(s);
}

const unifiedSchema = {
  $schema: "https://json-schema.org/draft/2020-12/schema",
  title: "Unified Proof Vault (Codex v5 + OceanOS)",
  type: "object",
  required: ["meta","refs","sig"],
  additionalProperties: false,
  properties: {
    meta: {
      type: "object",
      required: ["version","createdAt","generator","sources"],
      additionalProperties: false,
      properties: {
        version: { type: "string" },
        createdAt: { type: "string", format: "date-time" },
        generator: { type: "string" },
        sources: {
          type: "array",
          items: {
            type: "object",
            required: ["kind","path"],
            additionalProperties: false,
            properties: {
              kind: { type: "string", enum: ["codex","divergence"] },
              subtype: { type: "string" },
              path: { type: "string" }
            }
          }
        }
      }
    },
    refs: {
      type: "array",
      items: {
        type: "object",
        required: ["kind","subtype","path","payloadHash","kid","issuedAt"],
        additionalProperties: false,
        properties: {
          kind: { type: "string", enum: ["codex","divergence"] },
          subtype: { type: "string" },
          path: { type: "string" },
          payloadHash: { type: "string" },
          kid: { type: "string" },
          issuedAt: { type: "string", format: "date-time" }
        }
      }
    },
    sig: {
      type: "object",
      required: ["hash","signature","pubkey","kid","alg"],
      additionalProperties: false,
      properties: {
        hash: { type: "string" },
        signature: { type: "string" },
        pubkey: { type: "string" },
        kid: { type: "string" },
        alg: { type: "string", enum: ["Ed25519-SHA256-RFC8785"] }
      }
    }
  }
};

function json(obj, status=200, extraHeaders={}) {
  return new Response(JSON.stringify(obj, null, 2), {
    status,
    headers: { "content-type":"application/json; charset=utf-8", ...extraHeaders }
  });
}
function withCors(resp){
  const h = new Headers(resp.headers);
  if (!h.has("access-control-allow-origin")) {
    h.set("access-control-allow-origin", "*");
    h.set("access-control-allow-methods", "GET, POST, OPTIONS");
    h.set("access-control-allow-headers", "content-type, x-api-key");
  }
  return new Response(resp.body, { status: resp.status, headers: h });
}
