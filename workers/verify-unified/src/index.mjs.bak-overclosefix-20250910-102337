export default {
  async fetch(request) {
    const url = new URL(request.url);

    if (request.method === "OPTIONS") {
      return withCors(new Response(null, { status: 204 }));
    }

    if (url.pathname === "/health") {
      return withCors(json({ ok:true, ts:new Date().toISOString() }, 200, { "cache-control":"no-cache" }));
    }

    if (url.pathname === "/verify") {
      if (request.method !== "POST") return withCors(json({ ok:false, error:"POST only" }, 405));

      let data;
      try { data = await request.json(); }
      catch { return withCors(json({ ok:false, error:"invalid JSON" }, 400)); }

      const ajv = new Ajv({ allErrors:true, strict:false, validateSchema:false });
      addFormats(ajv);
      const validate = ajv.compile(unifiedSchema);
      if (!validate(data)) return withCors(json({ ok:false, stage:"schema", errors: validate.errors }, 422));

      try {
        const { meta, refs, sig } = data;
        const canon = canonicalize({ meta, refs });
        const hash  = await sha256_b64(canon);
        if (hash !== sig.hash) return withCors(json({ ok:false, stage:"unified-hash", expected:sig.hash, got:hash }, 400));

        const okSig = nacl.sign.detached.verify(
          u8FromB64(sig.hash),
          u8FromB64(sig.signature),
          u8FromB64(sig.pubkey)
        );
        if (!okSig) return withCors(json({ ok:false, stage:"unified-signature", error:"invalid signature" }, 400));

        return withCors(json({
          ok:true,
          verified:true,
          refs:Array.isArray(refs)? refs.length : 0,
          alg:sig.alg,
          rootHash:sig.hash
        }));
      } catch (e) {
        return withCors(json({ ok:false, stage:"exception", error: e?.message ?? String(e),
                               stack: (e?.stack ?? "").split("\n").slice(0,6) }, 500));
      }
    }

    return withCors(json({ ok:false, error:"Not Found" }, 404));
  }
};