    h.set("server-timing", timingParts.join(","));
    // Parallel debug headers (useful if a proxy touches Server-Timing)
    h.set("x-total-ms", totalMs.toFixed(3));
    h.set("x-wall-ms", wallMs.toFixed(3));

    const finalResp = new Response(resp.body, { status: resp.status ?? 200, headers: h });

