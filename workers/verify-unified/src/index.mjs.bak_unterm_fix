    try {
      console.log(JSON.stringify({
        evt: "access",
        reqId,
        method: request.method,
        path: url.pathname,
        status: finalResp.status,
        ms: totalMs,
        wall: wallMs
      }));
    } catch {}

    return finalResp;
  }
