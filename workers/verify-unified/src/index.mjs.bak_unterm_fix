  async fetch(request, env, ctx){
    const totalStartHi = performance.now();
    const totalStartWall = Date.now();
    const reqId = crypto.randomUUID();
    const url = new URL(request.url);
    let resp;

    try {
      if (request.method === "OPTIONS") {
        resp = new Response("", { status: 204 });
      } else if (url.pathname === "/health") {
        resp = json({ ok: true, ts: new Date().toISOString() });
      } else if (url.pathname === "/verify" && request.method === "POST") {
        resp = await handleVerify(request);
      } else {
        resp = json({ ok:false, error:"not-found" }, 404);
