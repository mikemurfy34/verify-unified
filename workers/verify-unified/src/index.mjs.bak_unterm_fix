      resp = json({ ok:false, route:"*", error:String(e?.message ?? e), stack:e?.stack }, 500);
    }

    // CORS
    resp = withCors(resp);

    // timings
    const totalMs = Math.max(0, performance.now() - totalStartHi);
    const wallMs = Math.max(0, Date.now() - totalStartWall);

    const h = new Headers(resp.headers ?? {});
    h.set("x-request-id", reqId);
    // Keep multi-metric: total (hi-res) + wall
    const stepFrag = h.get("x-step-timings"); // from handler, if present
    const timingParts = ['total;dur=' + totalMs.toFixed(3), 'wall;dur=' + wallMs.toFixed(3)];
