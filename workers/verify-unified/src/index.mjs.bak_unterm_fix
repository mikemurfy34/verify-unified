async function handleVerify(request){
  const steps = {}; const t = (name, v) => { steps[name] = (steps[name] ?? 0) + v; };

  // parse
  let t0 = performance.now();
  let body;
  try { body = await request.json(); }
  catch { return withCors(json({ ok:false, error:"invalid-json" }, 400)); }
  t("parse", performance.now() - t0);

  // schema
  t0 = performance.now();
  if (!validateUnified(body)) {
    t("schema", performance.now() - t0);
    return withCors(json({ ok:false, error:"schema", details: validateUnified.errors }, 422, { "x-step-timings": encodeSteps(steps) }));
  }
  t("schema", performance.now() - t0);

  // hash + verify
  t0 = performance.now();
  const { sig } = body;
  if (!sig || sig.alg !== "Ed25519-SHA256-RFC8785") {
    t("precheck", performance.now() - t0);
    return withCors(json({ ok:false, error:"unsupported-alg" }, 400, { "x-step-timings": encodeSteps(steps) }));
  }
  t("precheck", performance.now() - t0);

  try {
    // canon
    t0 = performance.now();
    const covered = { meta: body.meta, refs: body.refs };
    const canon = canonicalize(covered);
    t("canon", performance.now() - t0);

    // sha256
    t0 = performance.now();
    const digest = await sha256Bytes(canon);
    t("sha256", performance.now() - t0);

    // hash check
    t0 = performance.now();
    if (typeof sig.hash === "string") {
      const want = normB64(sig.hash);
      const got  = normB64(b64FromBytes(digest));
      if (want !== got) {
        t("hashcheck", performance.now() - t0);
        return withCors(json({ ok:false, error:"hash-mismatch" }, 400, { "x-step-timings": encodeSteps(steps) }));
      }
    }
    t("hashcheck", performance.now() - t0);

    // ed25519 verify
    t0 = performance.now();
    const pub = u8FromB64(sig.pubkey);
    const signature = u8FromB64(sig.signature);
    if (pub.length !== 32 || signature.length !== 64) {
      t("preverify", performance.now() - t0);
      return withCors(json({ ok:false, error:"bad-key-or-signature-length" }, 400, { "x-step-timings": encodeSteps(steps) }));
    }
    const ok = nacl.sign.detached.verify(digest, signature, pub);
    t("verify", performance.now() - t0);

    return withCors(json({ ok, alg: sig.alg }, 200, { "x-step-timings": encodeSteps(steps) }));
  } catch (e) {
    return withCors(json({ ok:false, error:String(e?.message ?? e) }, 500, { "x-step-timings": encodeSteps(steps) }));
  }
}

function encodeSteps(steps){
  // server-timing fragment + debug copies
  const parts = Object.entries(steps).map(([k,v]) => k + ';dur=' + v.toFixed(3));
  return parts.join(",");
}

