}
function toBase64(s) {
  let t = String(s).replace(/-/g, '+').replace(/_/g, '/');
  const pad = t.length % 4;
  if (pad) t += '='.repeat(4 - pad);
  return t;
}
function b64IsValid(b64) {
  if (typeof b64 !== 'string') return false;
  const n = b64.length;
  if (n === 0 || (n % 4) !== 0) return false;
  const isAlpha = c => (
    (c >= 'A' && c <= 'Z') ||
    (c >= 'a' && c <= 'z') ||
    (c >= '0' && c <= '9') ||
    c === '+' || c === '/'
  );
  const coreLen = n - Math.min(2, n);
  for (let i = 0; i < coreLen; i++) { const c = b64[i]; if (!isAlpha(c)) return false; }
  for (let i = coreLen; i < n; i++) { const c = b64[i]; if (c !== '=' && !isAlpha(c)) return false; }
  const firstEq = b64.indexOf('=');
  if (firstEq !== -1) {
    for (let i = firstEq; i < n; i++) if (b64[i] !== '=') return false;
    if ((n - firstEq) > 2) return false;
